<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MorseFlash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_black</item>
    </style>

    <!-- System launch screen: the icon on black, then MainActivity shows the full splash art. -->
    <style name="Theme.MorseFlash.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MorseFlash</item>
    </style>
</resources>
